#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <chrono>

using namespace std;
using namespace chrono;

vector<int> generateData(int n){
    vector<int> data;
    for(int i=0; i<n; i++){
        data.push_back(rand()%50000+1);
    }
    return data;
}

//quicksort
int partition(vector<int>& arr, int left, int right){
    int pivot=arr[right];
    int i=left-1;
    
    for(int j=left; j<right; j++){
        if(arr[j]<pivot){
            i++;
            swap(arr[i], arr[j]);
        }
    }
    swap(arr[i+1], arr[right]);
    return i+1;
}

void quickSort(vector<int>& arr, int left, int right){
    if(left<right){
        int pi=partition(arr, left, right);
        quickSort(arr, left, pi-1);
        quickSort(arr, pi+1, right);
    }
}

//mergesort
void merge(vector<int>& arr, int l, int m, int n){
    vector<int> left(arr.begin()+l, arr.begin()+m+1);
    vector<int> right(arr.begin()+m+1, arr.begin()+n+1);
    
    int i=0, j=0, k=l;
    
    while(i<left.size()&&j<right.size()){
        if(left[i]<right[j]) arr[k++]=left[i++];
        else arr[k++]=right[j++];
    }
    while(i<left.size()) arr[k++]=left[i++];
    while(j<right.size()) arr[k++]=right[j++];
}

void mergeSort(vector<int>& arr, int l, int r){
    if(l<r){
        int m=(l+r)/2;
        mergeSort(arr, l, m);
        mergeSort(arr, m+1, r);
        merge(arr, l, m, r);
    }
}

//heapsort
void adjust(vector<int>& arr, int n, int i){
    int root=i;
    int l=2*i+1;
    int r=2*i+2;
    
    if(l<n&&arr[l]>arr[root]) root=l;
    if(r<n&&arr[r]>arr[root]) root=r;
    if(root !=i){
        swap(arr[i], arr[root]);
        adjust(arr, n, root);
    }
}

void heapSort(vector<int>& arr){
    int n=arr.size();
    
    for(int i=n/2-1; i>=0; i--) adjust(arr, n, i);
    for(int i=n-1; i>0; i--){
        swap(arr[0], arr[i]);
        adjust(arr, i, 0);
    }
}

void printAll(const vector<int>& arr){
    for(int i=0; i<arr.size(); i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}

int main(){
    srand(time(0));
    int n, choice;
    
    cout<<"n個數字:";
    cin>>n;
    
    cout<<"Choose Sort(1.Quick Sort, 2.Merge Sort, Heap Sort):\n";
    cin>>choice;
    
    vector<int> data=generateData(n);
    auto start=high_resolution_clock::now();
    
    if(choice==1){quickSort(data, 0, n-1);}
    else if(choice==2){mergeSort(data, 0, n-1);}
    else if(choice==3){heapSort(data);}
    else{
        cout<<"error\n";
        return 0;
    }
    auto end=high_resolution_clock::now();
    double time=duration<double, micro>(end-start).count();
    
    printAll(data);
    
    cout<<"\ntime:"<<time/1000.0<<" ms"<<endl;
    
    return 0;
}
